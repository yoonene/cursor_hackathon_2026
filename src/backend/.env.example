# CLōD / OpenAI-compatible Chat Completions (initial reading only)
# Copy this file to `.env` in the same directory (`src/backend/`) and set real values.
# Restart Uvicorn after changing `.env`.

# Required for LLM-generated counselor copy (all three must be non-empty).
CLOD_API_KEY=
CLOD_BASE_URL=https://YOUR-CLOD-HOST/openai/v1
CLOD_STRONG_MODEL=your-strong-chat-model-slug

# Optional (reserved for routing / lighter calls — not wired in initial-reading path yet).
# CLOD_FAST_MODEL=
# CLOD_CREATIVE_MODEL=
