# CLōD / OpenAI-compatible Chat Completions
# Copy this file to `.env` in the same directory (`src/backend/`) and set real values.
# Restart Uvicorn after changing `.env`.

# Required for LLM paths (routing when fast model unset + counselor copy): all non-empty.
CLOD_API_KEY=
CLOD_BASE_URL=https://YOUR-CLOD-HOST/openai/v1
CLOD_STRONG_MODEL=your-strong-chat-model-slug

# Optional — lightweight model used only for POST /chat intent routing (JSON classification).
# If unset or empty, routing uses CLOD_STRONG_MODEL (same as follow-up counselor replies).
CLOD_FAST_MODEL=

# Optional — reserved for future lighter/creative endpoints.
# CLOD_CREATIVE_MODEL=
